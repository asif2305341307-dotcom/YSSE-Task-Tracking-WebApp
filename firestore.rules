rules_version = '2';

// YSSE Task 05 - Firestore Security Rules
//
// Admin model: a user is an admin ONLY if a document exists at /admins/{uid}.
// Nobody can write to /admins from the app (allow write: if false), so the
// admin list can only be changed from the Firebase Console or a trusted server.
// This does not need Cloud Functions or a paid plan.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // ---------- admins (read-only from the app) ----------
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // ---------- users (intern profiles) ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // An intern can create ONLY their own profile, and only as role "intern".
      // Profiles can never be updated or deleted from the app, so the role
      // and Intern ID cannot be changed later.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'internId', 'fullName', 'email', 'role', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.role == 'intern'
        && request.resource.data.internId is string
        && request.resource.data.internId.matches('^YSSE-2026-[0-9]{3,6}$')
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // ---------- counters (used to generate Intern IDs) ----------
    match /counters/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && id == 'interns'
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if signedIn() && id == 'interns'
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // ---------- tasks (created by admin, read by everyone signed in) ----------
    match /tasks/{taskId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---------- submissions ----------
    match /submissions/{submissionId} {

      function validNewSubmission() {
        let d = request.resource.data;
        return d.keys().hasOnly([
            'uid', 'internId', 'taskId', 'taskNumber', 'taskTitle',
            'description', 'githubUrl', 'reportUrl', 'notes', 'submittedAt',
            'status', 'adminFeedback', 'reviewedAt', 'reviewedBy'])
          && d.uid == request.auth.uid
          && myProfile().role == 'intern'
          && d.internId == myProfile().internId
          && d.taskId is string
          && get(/databases/$(database)/documents/tasks/$(d.taskId)).data.isActive == true
          && d.taskNumber is number
          && d.taskTitle is string && d.taskTitle.size() > 0 && d.taskTitle.size() <= 150
          && d.description is string && d.description.size() >= 10 && d.description.size() <= 3000
          && d.githubUrl is string && d.githubUrl.matches('^https://github\\.com/[^ ]+$')
          && d.reportUrl is string && d.reportUrl.matches('^https?://[^ ]+$')
          && d.notes is string && d.notes.size() <= 1000
          && d.submittedAt == request.time
          && d.status == 'pending'
          && d.adminFeedback == ''
          && d.reviewedAt == null
          && d.reviewedBy == '';
      }

      // Interns read only their own; admins read all.
      allow read: if signedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if signedIn() && validNewSubmission();

      // Only admins can change status / feedback, and nothing else.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'adminFeedback', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['pending', 'approved', 'rejected']
        && request.resource.data.adminFeedback is string
        && request.resource.data.adminFeedback.size() <= 1000
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;

      allow delete: if isAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
